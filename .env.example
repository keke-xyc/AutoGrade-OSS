# Copy to .env. Never commit the real file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Legacy upgrade bootstrap only: imports the existing hash into admin once.
# New installations use python manage.py setup; account passwords live in SQLite.
ADMIN_PASSWORD_HASH=
# Use true behind HTTPS. Keep false ONLY for local HTTP testing.
COOKIE_SECURE=false
# Set your public HTTPS origin in production, e.g. https://homework.example.com
PUBLIC_ORIGIN=
DATA_DIR=data
# Production only; hostname without https://
DOMAIN=
# Optional flat prices per 1M tokens. Fill all three to override the official CNY range.
# Leave blank for official Flash peak/off-peak estimates; billing remains provider-side.
PRICE_INPUT_MISS=
PRICE_INPUT_HIT=
PRICE_OUTPUT=
PRICE_CURRENCY=CNY
